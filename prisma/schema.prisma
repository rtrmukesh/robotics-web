generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
}


model User {
  id            String   @id @default(uuid())
  auth_id       String   @unique
  name          String?
  email         String   @unique
  avatar_url    String?
  phone_number  String?
  gender        Gender?
  date_of_birth String?
  address       String?
  role_id       Int      @default(1)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  deleted_at    DateTime?

  @@map("user")
}

enum Gender {
  male
  female
  other
}
